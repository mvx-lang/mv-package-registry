#!/bin/sh
# uv-run <command...> — run a command inside the licensed uv-builder container,
# with the current directory mounted at /pkg (the working dir).  Installed on
# PATH by the setup-uv action, so a self-hosted-runner workflow can use the
# licensed UniVerse toolchain the same way setup-udt exposes UniData — except
# the tool stays on the runner (it cannot be shipped).
# Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only.
#
#   uv-run 'BASIC BP MYPROG'         # run BASIC / any UniVerse command
#   uv-run sh build-uv.sh /pkg/dist  # …or a build script
#
# The arguments are joined and run as a shell command line inside the container
# (a login shell, so $UVHOME etc. are set).  The container runs as root, so
# files it creates in the mounted tree are chowned back to the runner user on
# the way out — otherwise a root-owned file blocks the runner's next checkout.
set -eu

IMAGE="${UV_BUILDER_IMAGE:-uv-builder:14.2.1}"
[ "$#" -gt 0 ] || { echo "usage: uv-run <command...>" >&2; exit 2; }
UV_RUN_CMD="$*"
export UV_RUN_CMD

# --hostname universe matches the install (belt and braces against any host
# binding in the licence).  --shm-size gives UniVerse's shared memory room — a
# build that runs uv (mkaccount/BASIC) needs it; harmless otherwise.
# GITHUB_REF_NAME is forwarded so a build script can stamp the version.
exec docker run --rm --hostname universe --shm-size="${UV_SHM_SIZE:-256m}" \
  -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
  -e GITHUB_REF_NAME="${GITHUB_REF_NAME:-}" \
  -e UV_RUN_CMD \
  -v "$PWD":/pkg -w /pkg "$IMAGE" \
  bash -lc 'rc=0; eval "$UV_RUN_CMD" || rc=$?; chown -R "$HOST_UID:$HOST_GID" . 2>/dev/null || true; exit $rc'
